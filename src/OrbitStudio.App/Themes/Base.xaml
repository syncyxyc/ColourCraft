<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Basis-Theme (M1): helle Oberfläche, dunkle Arbeitsfläche.
        Alle Farben sind Design-Tokens. Views verwenden ausschließlich diese Schlüssel per DynamicResource,
        damit das Theme-System (M9) sie zur Laufzeit austauschen kann.
    -->
    <Color x:Key="Color.Window.Background">#FFF3F3F3</Color>
    <Color x:Key="Color.Menu.Background">#FFF9F9F9</Color>
    <Color x:Key="Color.StatusBar.Background">#FFE8E8E8</Color>
    <Color x:Key="Color.Workspace.Background">#FF3A3A3E</Color>
    <Color x:Key="Color.Text">#FF1E1E1E</Color>
    <Color x:Key="Color.Text.Muted">#FFC8C8CC</Color>
    <Color x:Key="Color.Border">#FFBDBDBD</Color>
    <Color x:Key="Color.Accent">#FF2F6FDE</Color>
    <Color x:Key="Color.Error">#FFC42B1C</Color>
    <Color x:Key="Color.Checker.Light">#FFFFFFFF</Color>
    <Color x:Key="Color.Checker.Dark">#FFCCCCCC</Color>
    <Color x:Key="Color.Document.Paper">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Window.Background" Color="{StaticResource Color.Window.Background}" />
    <SolidColorBrush x:Key="Brush.Menu.Background" Color="{StaticResource Color.Menu.Background}" />
    <SolidColorBrush x:Key="Brush.StatusBar.Background" Color="{StaticResource Color.StatusBar.Background}" />
    <SolidColorBrush x:Key="Brush.Workspace.Background" Color="{StaticResource Color.Workspace.Background}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.Document.Paper" Color="{StaticResource Color.Document.Paper}" />

    <!-- Schachbrett für transparente Bereiche: 8×8-Felder, Kachel 16×16 Einheiten. -->
    <DrawingBrush x:Key="Brush.Checkerboard" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"
                  Stretch="None" AlignmentX="Left" AlignmentY="Top">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H16 V16 H0 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="{StaticResource Color.Checker.Light}" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="{StaticResource Color.Checker.Dark}" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
