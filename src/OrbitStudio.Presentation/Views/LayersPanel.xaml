<UserControl x:Class="OrbitStudio.Presentation.Views.LayersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OrbitStudio.Presentation.ViewModels"
             xmlns:conv="clr-namespace:OrbitStudio.Presentation.Converters"
             AutomationProperties.Name="{StaticResource Panel.Layers.Title}">
    <!-- DataContext: DocumentViewModel des aktiven Dokuments. Befehle kommen vom MainViewModel (Fenster). -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisible" />
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource Brush.Panel.Background}">
        <TextBlock DockPanel.Dock="Top" Text="{StaticResource Panel.Layers.Title}" FontWeight="SemiBold" Margin="8,6" />

        <!-- Schaltflächen: dieselben Registry-Befehle wie im Menü „Ebenen" -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,4,8,8">
            <Button Style="{StaticResource PanelButton}" Content="＋" x:Name="NewButton"
                    Command="{Binding DataContext.NewLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="{StaticResource Panel.Layers.New}" AutomationProperties.Name="{StaticResource Panel.Layers.New}" />
            <Button Style="{StaticResource PanelButton}" Content="⧉"
                    Command="{Binding DataContext.DuplicateLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="{StaticResource Panel.Layers.Duplicate}" AutomationProperties.Name="{StaticResource Panel.Layers.Duplicate}" />
            <Button Style="{StaticResource PanelButton}" Content="▲"
                    Command="{Binding DataContext.MoveLayerUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="{StaticResource Panel.Layers.Up}" AutomationProperties.Name="{StaticResource Panel.Layers.Up}" />
            <Button Style="{StaticResource PanelButton}" Content="▼"
                    Command="{Binding DataContext.MoveLayerDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="{StaticResource Panel.Layers.Down}" AutomationProperties.Name="{StaticResource Panel.Layers.Down}" />
            <Button Style="{StaticResource PanelButton}" Content="✕"
                    Command="{Binding DataContext.DeleteLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="{StaticResource Panel.Layers.Delete}" AutomationProperties.Name="{StaticResource Panel.Layers.Delete}" />
        </StackPanel>

        <!-- Deckkraft und Mischmodus der aktiven Ebene -->
        <Grid DockPanel.Dock="Bottom" Margin="8,4" IsEnabled="{Binding HasSelectedLayer}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="{StaticResource Panel.Layers.Opacity}" Target="{Binding ElementName=OpacitySlider}" Padding="0,4,6,4" />
            <Slider Grid.Column="1" x:Name="OpacitySlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                    VerticalAlignment="Center" IsMoveToPointEnabled="True"
                    Value="{Binding SelectedOpacityPercent, Mode=TwoWay, Delay=40}"
                    AutomationProperties.Name="{StaticResource Panel.Layers.Opacity}" />
            <TextBlock Grid.Column="2" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding SelectedOpacityPercent, StringFormat={}{0:0} %}" />
            <Label Grid.Row="1" Content="{StaticResource Panel.Layers.BlendMode}" Target="{Binding ElementName=BlendCombo}" Padding="0,4,6,4" />
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="BlendCombo" Margin="0,2"
                      ItemsSource="{Binding BlendModes}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedBlendMode, Mode=TwoWay}"
                      AutomationProperties.Name="{StaticResource Panel.Layers.BlendMode}" />
        </Grid>

        <ListBox x:Name="LayerList" Margin="8,0" ItemsSource="{Binding Layers}"
                 SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                 MouseDoubleClick="OnLayerDoubleClick"
                 ToolTip="{StaticResource Panel.Layers.Properties}" ToolTipService.InitialShowDelay="1500"
                 HorizontalContentAlignment="Stretch"
                 AutomationProperties.Name="{StaticResource Panel.Layers.Title}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="Padding" Value="2" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LayerItemViewModel}">
                    <Grid Margin="{Binding Indent}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"
                                  ToolTip="{StaticResource Panel.Layers.Visible}"
                                  AutomationProperties.Name="{StaticResource Panel.Layers.Visible}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Details}" FontSize="10" Opacity="0.7" />
                        </StackPanel>
                        <Border Grid.Column="2" Margin="4,0" Padding="3,0" BorderThickness="1" CornerRadius="2"
                                BorderBrush="{DynamicResource Brush.Border}" VerticalAlignment="Center"
                                Visibility="{Binding HasMask, Converter={StaticResource BoolToVisible}}"
                                Opacity="{Binding MaskOpacity}" ToolTip="{Binding MaskToolTip}">
                            <TextBlock Text="M" FontSize="10" />
                        </Border>
                        <CheckBox Grid.Column="3" IsChecked="{Binding IsLocked, Mode=TwoWay}" VerticalAlignment="Center"
                                  Content="🔒" ToolTip="{StaticResource Panel.Layers.Locked}"
                                  AutomationProperties.Name="{StaticResource Panel.Layers.Locked}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
