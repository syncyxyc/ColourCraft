<Window x:Class="OrbitStudio.Presentation.Views.NewDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource Dlg.New.Title}"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <Grid Margin="16" MinWidth="320">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="{StaticResource Dlg.New.Name}" Target="{Binding ElementName=NameBox}" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,2" />

        <Label Grid.Row="1" Content="{StaticResource Dlg.New.Width}" Target="{Binding ElementName=WidthBox}" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="WidthBox" Margin="0,2" />

        <Label Grid.Row="2" Content="{StaticResource Dlg.New.Height}" Target="{Binding ElementName=HeightBox}" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="HeightBox" Margin="0,2" />

        <Label Grid.Row="3" Content="{StaticResource Dlg.New.Background}" Target="{Binding ElementName=WhiteOption}" />
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="WhiteOption" GroupName="Background" IsChecked="True" Margin="0,0,12,0"
                         Content="{StaticResource Dlg.New.Background.White}" />
            <RadioButton x:Name="TransparentOption" GroupName="Background"
                         Content="{StaticResource Dlg.New.Background.Transparent}" />
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" x:Name="ErrorText" Margin="0,8,0,0" MaxWidth="360"
                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" Visibility="Collapsed" />

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="{StaticResource Common.Ok}" MinWidth="88" IsDefault="True" Click="OnOk" />
            <Button Content="{StaticResource Common.Cancel}" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
