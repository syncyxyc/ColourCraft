<UserControl x:Class="OrbitStudio.Presentation.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OrbitStudio.Presentation.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
    </UserControl.Resources>

    <!-- Arbeitsfläche: Schachbrett für Transparenz, darüber der Dokumenthintergrund.
         In M1 entspricht 1 Dokumentpixel 1 geräteunabhängiger Einheit (Zoom/DPI-Abbildung folgt in M2). -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource Brush.Workspace.Background}" Focusable="False">
        <Border x:Name="Page" Margin="32"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="{Binding Width}" Height="{Binding Height}"
                SnapsToDevicePixels="True"
                MouseMove="OnPageMouseMove" MouseLeave="OnPageMouseLeave"
                AutomationProperties.Name="Leinwand">
            <Grid>
                <Rectangle Fill="{DynamicResource Brush.Checkerboard}" />
                <Rectangle Fill="{DynamicResource Brush.Document.Paper}"
                           Visibility="{Binding IsTransparent, Converter={StaticResource BoolToCollapsed}}" />
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
