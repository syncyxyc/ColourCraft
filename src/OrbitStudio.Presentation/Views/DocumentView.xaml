<UserControl x:Class="OrbitStudio.Presentation.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vp="clr-namespace:OrbitStudio.Presentation.Viewport">
    <!-- Arbeitsfläche mit eigenen Scrollleisten. Zoom und Verschiebung stehen in DocumentViewModel.View. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <vp:CanvasView x:Name="Canvas" ViewModel="{Binding}"
                       ShowPixelGrid="{Binding DataContext.ShowPixelGrid, RelativeSource={RelativeSource AncestorType=Window}}"
                       ToolTip="{StaticResource Workspace.CanvasHint}" ToolTipService.InitialShowDelay="2000"
                       AutomationProperties.Name="Leinwand" />

        <ScrollBar x:Name="VerticalBar" Grid.Column="1" Orientation="Vertical" Minimum="0"
                   ValueChanged="OnVerticalScroll" AutomationProperties.Name="Vertikal scrollen" />
        <ScrollBar x:Name="HorizontalBar" Grid.Row="1" Orientation="Horizontal" Minimum="0"
                   ValueChanged="OnHorizontalScroll" AutomationProperties.Name="Horizontal scrollen" />
    </Grid>
</UserControl>
