<Window x:Class="OrbitStudio.Presentation.Views.LayerPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource Dlg.Layer.Title}"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text}">
    <Grid Margin="16" MinWidth="340">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="{StaticResource Dlg.Layer.Name}" Target="{Binding ElementName=NameBox}" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,2" />

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
            <CheckBox x:Name="VisibleBox" Content="{StaticResource Dlg.Layer.Visible}" Margin="0,0,16,0" />
            <CheckBox x:Name="LockedBox" Content="{StaticResource Dlg.Layer.Locked}" />
        </StackPanel>

        <Label Grid.Row="2" Content="{StaticResource Dlg.Layer.Opacity}" Target="{Binding ElementName=OpacityBox}" />
        <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                    VerticalAlignment="Center" ValueChanged="OnSliderChanged"
                    AutomationProperties.Name="{StaticResource Dlg.Layer.Opacity}" />
            <TextBox Grid.Column="1" x:Name="OpacityBox" Margin="8,0,0,0" TextChanged="OnOpacityTextChanged" />
        </Grid>

        <Label Grid.Row="3" Content="{StaticResource Dlg.Layer.BlendMode}" Target="{Binding ElementName=BlendBox}" />
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="BlendBox" Margin="0,2" DisplayMemberPath="Name" />

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" x:Name="ErrorText" Margin="0,8,0,0" MaxWidth="360"
                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" Visibility="Collapsed" />

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{StaticResource Common.Ok}" MinWidth="88" IsDefault="True" Click="OnOk" />
            <Button Content="{StaticResource Common.Cancel}" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
