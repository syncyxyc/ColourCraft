    <!-- Effektnamen und -beschreibungen (Schlüssel Effect.<Id>) -->
    <sys:String x:Key="Effect.brightnessContrast">Helligkeit/Kontrast</sys:String>
    <sys:String x:Key="Effect.brightnessContrast.Description">Hellt das Bild auf oder dunkelt es ab und verstärkt oder verringert den Kontrast um die Mitte (Grau 127,5).</sys:String>
    <sys:String x:Key="Effect.brightness">Helligkeit</sys:String>
    <sys:String x:Key="Effect.brightness.Description">Addiert zu jedem Farbkanal 2,55 × Wert.</sys:String>
    <sys:String x:Key="Effect.contrast">Kontrast</sys:String>
    <sys:String x:Key="Effect.contrast.Description">Spreizt oder staucht die Farbwerte um die Mitte; −100 % ergibt Grau.</sys:String>
    <sys:String x:Key="Effect.hueSaturation">Farbton/Sättigung</sys:String>
    <sys:String x:Key="Effect.hueSaturation.Description">Dreht den Farbton und ändert die Sättigung (HSL); Helligkeit bleibt.</sys:String>
    <sys:String x:Key="Effect.hue">Farbton</sys:String>
    <sys:String x:Key="Effect.hue.Description">Dreht den Farbton (HSL) um den angegebenen Winkel.</sys:String>
    <sys:String x:Key="Effect.saturation">Sättigung</sys:String>
    <sys:String x:Key="Effect.saturation.Description">Verstärkt oder verringert die Sättigung (HSL); −100 % ergibt Grau.</sys:String>
    <sys:String x:Key="Effect.levels">Tonwertkorrektur</sys:String>
    <sys:String x:Key="Effect.levels.Description">Bildet den Eingabebereich (Schwarz- bis Weißpunkt) mit Gamma auf den Ausgabebereich ab.</sys:String>
    <sys:String x:Key="Effect.channels">Farbkanäle anpassen</sys:String>
    <sys:String x:Key="Effect.channels.Description">Verstärkt oder dämpft Rot, Grün und Blau einzeln (0–200 %).</sys:String>
    <sys:String x:Key="Effect.blackWhite">Schwarzweiß</sys:String>
    <sys:String x:Key="Effect.blackWhite.Description">Wandelt in Graustufen um (Helligkeit nach BT.601).</sys:String>
    <sys:String x:Key="Effect.invert">Invertieren</sys:String>
    <sys:String x:Key="Effect.invert.Description">Kehrt alle Farben um (255 − Wert); die Deckkraft bleibt.</sys:String>
    <sys:String x:Key="Effect.sepia">Sepia</sys:String>
    <sys:String x:Key="Effect.sepia.Description">Färbt das Bild bräunlich wie ein altes Foto.</sys:String>
    <sys:String x:Key="Effect.gaussianBlur">Gaußscher Weichzeichner</sys:String>
    <sys:String x:Key="Effect.gaussianBlur.Description">Weiches Verwischen mit Gaußverteilung (σ = Radius/2).</sys:String>
    <sys:String x:Key="Effect.boxBlur">Einfacher Weichzeichner</sys:String>
    <sys:String x:Key="Effect.boxBlur.Description">Mittelwert über ein Quadrat der Kantenlänge 2 × Radius + 1.</sys:String>
    <sys:String x:Key="Effect.sharpen">Schärfen</sys:String>
    <sys:String x:Key="Effect.sharpen.Description">Verstärkt Kanten (Unscharf maskieren): Original + Stärke × (Original − Weichgezeichnet).</sys:String>
    <sys:String x:Key="Effect.noise">Rauschen hinzufügen</sys:String>
    <sys:String x:Key="Effect.noise.Description">Fügt gaußverteiltes Rauschen hinzu; gleicher Startwert ergibt dasselbe Muster.</sys:String>
    <sys:String x:Key="Effect.denoise">Rauschreduktion</sys:String>
    <sys:String x:Key="Effect.denoise.Description">Entfernt Bildrauschen und einzelne Störpixel mit einem Medianfilter; Kanten bleiben erhalten.</sys:String>
    <sys:String x:Key="Effect.edges">Kantenerkennung</sys:String>
    <sys:String x:Key="Effect.edges.Description">Zeigt Helligkeitskanten (Sobel) als helle Linien auf Schwarz.</sys:String>
    <sys:String x:Key="Effect.dropShadow">Schlagschatten</sys:String>
    <sys:String x:Key="Effect.dropShadow.Description">Legt einen versetzten, weichen Schatten der Ebenenform unter den Inhalt.</sys:String>
    <sys:String x:Key="Effect.pixelate">Verpixeln</sys:String>
    <sys:String x:Key="Effect.pixelate.Description">Fasst Zellen gleicher Größe zu einer Farbe zusammen (Mittelwert).</sys:String>

